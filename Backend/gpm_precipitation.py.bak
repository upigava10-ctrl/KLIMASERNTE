class GPMPrecipitation:
    # Precipitation related data to location ( longitude and latitude )
    # Training ready model with topographic data and precipitation data from GPM IMERG

    def __init__(self, path):
        self.path = path

    def read_data(self):
        for file in glob.iglob(f'{self.path}/*.HDF5'):
            ds = xr.open_dataset(file, engine="netcdf4", group="Grid")
            print(list(ds.variables.keys()))
            return ds

# Look for data around sonora, mexico
def obtain_data():
    earthaccess.login(persist=True)
    results = earthaccess.search_data(
        doi="10.5067/GPM/IMERG/3B-HH-L/07",
        # Example: Filter for a specific region (e.g., Mexico) and date range
        bounding_box=(-120, 15, -85, 35), 
        temporal=("2023-01-01", "2024-01-05"),
        count=10
    )

    # Download to a specific folder
    files = earthaccess.download(results)
    print(files)

# Saved data are multiple folders depending on dates
